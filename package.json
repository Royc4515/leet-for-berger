{
  "name": "leet-for-berger",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive coding assessment platform: Monaco editor, 15-case test harness, learning path, interview/battle/mentor modes.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:affected": "node scripts/ci/run-affected.mjs",
    "test:e2e": "node e2e/smoke.mjs",
    "check": "npm test && npm run test:e2e",
    "check:db": "bash scripts/db/check-schema.sh",
    "db:export": "node scripts/db/export-sql.mjs",
    "import:solutions": "node scripts/import/fetch-solutions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.49.0",
    "sql.js": "1.13.0",
    "typescript": "5.6.3"
  }
}
